# Copy this file to .env (or .env.docker) and fill in real values.

# PostgreSQL configuration
POSTGRES_DB=animal_register
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# JWT configuration
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_32B_MIN
JWT_REFRESH_TOKEN=REPLACE_WITH_SECURE_RANDOM_SECRET_32B_MIN
JWT_ACCESS_TOKEN_EXPIRATION=7d
JWT_REFRESH_TOKEN_EXPIRATION=7d

# NextAuth configuration
NEXTAUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_32B_MIN
NEXTAUTH_URL=http://localhost
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=REPLACE_WITH_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=REPLACE_WITH_RECAPTCHA_SECRET_KEY
AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_32B_MIN
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost

# CORS configuration for backend (Docker stack)
CORS_ORIGIN=*
