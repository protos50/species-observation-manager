# Plantilla de variables de entorno del frontend (Next.js).
# Copiar a .env y completar con valores reales. NUNCA versionar el .env.

# Secreto de NextAuth. Generar uno propio con:  npx auth secret
AUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"

# URL publica de la aplicacion (sin barra final).
# En desarrollo: http://localhost:3000
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# API del backend.
# NEXT_PUBLIC_* se resuelve en el navegador y queda incrustada en el bundle
# durante el build (no en tiempo de ejecucion).
# API_BASE_URL_SERVER se usa en el codigo que corre en el servidor de Next.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
API_BASE_URL_SERVER="http://localhost:4000/api"

# reCAPTCHA (formulario publico de contacto).
# Obtener en https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=REPLACE_WITH_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=REPLACE_WITH_RECAPTCHA_SECRET_KEY
