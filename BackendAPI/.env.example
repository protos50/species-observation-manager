# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Copy this file to .env and fill in real values for local development.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/animal_register?schema=public"

jwtSecretKey="REPLACE_WITH_SECURE_RANDOM_SECRET"
jwtRefreshToken="REPLACE_WITH_SECURE_RANDOM_SECRET"

# JWT Token Expiration (desarrollo local)
JWT_ACCESS_TOKEN_EXPIRATION="7d"
JWT_REFRESH_TOKEN_EXPIRATION="7d"
