# BackendAPI Docker ignore
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
/dist
/.next
/.turbo

# Test & coverage
/coverage
/.nyc_output

# Docs, backups y scripts de desarrollo (no necesarios en runtime)
/docs
/db_backups
/scripts

# Tooling (no necesario en runtime)
/.prettierrc
/.prettierignore
/eslint.config.mjs

# Markdown de documentación
/*.md

# Environment & config
.env
.env.*
!.env.example

# VCS & editor
.git
.gitignore
.vscode
.idea
.DS_Store

# Logs
logs
*.log
npm-debug.log*

# OS / misc
Thumbs.db
