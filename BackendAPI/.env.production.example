# Production Environment Variables Example
# Copy this file to .env.production and update with real values

# Database Connection (PostgreSQL en Docker VPS)
DATABASE_URL="postgresql://postgres:123@localhost:5432/animal_register?schema=public"

# JWT Secret Keys (IMPORTANT: Use secure random strings in production)
jwtSecretKey="YOUR_SECURE_SECRET_KEY_HERE"
jwtRefreshToken="YOUR_SECURE_REFRESH_TOKEN_KEY_HERE"

# JWT Token Expiration Configuration
# Opciones: '20s', '1h', '24h', etc
# Desarrollo: '1h' recomendado para mejor UX
# Producción: Ajustar según necesidades de seguridad
JWT_ACCESS_TOKEN_EXPIRATION="1h"
JWT_REFRESH_TOKEN_EXPIRATION="7d"

# Server Port
PORT=4000
